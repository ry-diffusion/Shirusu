        }
      }
    },
    "Start recording" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começar a gravar"
          }
        }
      }
    },
    "Listening back…" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvindo de volta…"
          }
        }
