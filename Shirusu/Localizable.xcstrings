{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” decoded to silence." : {
      "comment" : "Error when a file contains no audio",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não tinha áudio nenhum."
          }
        }
      }
    },
    "%@ copy" : {
      "comment" : "Name of a duplicated profile",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cópia de %@"
          }
        }
      }
    },
    "8,192 tokens" : {
      "comment" : "A description of the number of tokens that Gemini 3 Flash can process.",
      "isCommentAutoGenerated" : true
    },
    "32,768 tokens (long profiles)" : {
      "comment" : "A description of the maximum number of tokens that Gemini can output.",
      "isCommentAutoGenerated" : true
    },
    "A number went missing or changed, so it was discarded." : {
      "comment" : "Why a rewrite was not used",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um número sumiu ou mudou, então foi descartado."
          }
        }
      }
    },
    "A whole word only, matched without case. It cannot paraphrase and it cannot touch a word that is not listed, which is the point: it runs before the model does, and it is the one step here that cannot invent anything." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só palavra inteira, sem diferenciar maiúsculas. Não parafraseia e não toca em palavra que não esteja na lista, e esse é o ponto: roda antes do modelo, e é o único passo aqui que não pode inventar nada."
          }
        }
      }
    },
    "Add a Gemini API key before using Gemini for rewriting." : {
      "comment" : "Why a Gemini rewrite was not used"
    },
    "Add a Gemini API key in Configure to use Gemini for rewriting." : {
      "comment" : "A description of why the RewriteUnavailable view is",
      "isCommentAutoGenerated" : true
    },
    "Add a word" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar palavra"
          }
        }
      }
    },
    "Aggressive" : {
      "comment" : "Built-in profile name",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agressivo"
