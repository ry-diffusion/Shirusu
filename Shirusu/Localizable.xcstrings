            "value" : "palavras não conferem"
          }
        }
      }
    },
    "Give me another line" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me dá outra frase"
          }
        }
      }
    },
    "Say anything in a normal voice for about ten seconds — what you had for lunch, what you are working on." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale qualquer coisa em voz normal por uns dez segundos — o que você almoçou, no que está trabalhando."
          }
        }
      }
    },
    "Somewhere quiet, one voice, and stay about the same distance from the microphone. The model listens to the first ten seconds." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num lugar silencioso, uma voz só, e fique mais ou menos à mesma distância do microfone. O modelo ouve os dez primeiros segundos."
          }
        }
      }
    },
    "Not recording" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não está gravando"
